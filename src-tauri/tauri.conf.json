{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "VYRE",
  "version": "0.1.0",
  "identifier": "dev.bxane.vyre",
  "build": {
    "beforeDevCommand": "npm run dev",
    "beforeBuildCommand": "npm run build",
    "devUrl": "http://localhost:1420",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "title": "VYRE — Network Intelligence",
        "width": 1350,
        "height": 870,
        "minWidth": 760,
        "minHeight": 620,
        "resizable": true
      }
    ],
    "security": {
      "csp": "default-src 'self'; connect-src ipc: http://ipc.localhost http://localhost:1420 ws://localhost:1420; img-src 'self' data:; style-src 'self' 'unsafe-inline'"
    }
  },
  "bundle": {
    "active": true,
    "category": "Utility",
    "shortDescription": "Transparent gaming network diagnostics",
    "icon": [
      "icons/icon.png",
      "icons/icon.ico"
    ]
  }
}
